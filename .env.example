# YouTube Data API v3 key
YOUTUBE_API_KEY=YOUR_YOUTUBE_KEY_HERE

# Groq API key (Primary / default LLM provider)
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API key (Optional secondary provider)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Delay between LLM requests in seconds (default: 3 for Groq free tier 8K TPM)
GROQ_DELAY_SECONDS=3
GEMINI_DELAY_SECONDS=4
